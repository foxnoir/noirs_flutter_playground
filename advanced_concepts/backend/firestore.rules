rules_version = '2';

// Practice lab: open so Functions (Admin SDK) and a later Firestore SDK
// client can both write. Do not copy this into a real app.
service cloud.firestore {
  match /databases/{database}/documents {
    match /books/{bookId} {
      allow read, write: if true;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
