#!/bin/sh
# Playground monorepo: block the push if any app's tests fail.

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root" || exit 1

export PATH="${HOME}/.pub-cache/bin:${PATH}"

apps_file="${repo_root}/coverage_pipeline/playground_apps"
runner="${repo_root}/coverage_pipeline/run_flutter_tests.sh"
if [ ! -f "$apps_file" ]; then
  echo "pre-push: missing ${apps_file}." >&2
  exit 1
fi
if [ ! -x "$runner" ]; then
  echo "pre-push: missing ${runner}." >&2
  exit 1
fi

echo "Running tests before push…"

while IFS= read -r app || [ -n "${app:-}" ]; do
  case "$app" in
    '' | \#*) continue ;;
  esac
  if ! "$runner" "${repo_root}/${app}" "$app"; then
    exit 1
  fi
done <"$apps_file"

echo "All tests passed."
exit 0
