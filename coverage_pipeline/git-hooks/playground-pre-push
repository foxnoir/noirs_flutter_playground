#!/bin/sh
# Playground monorepo: block the push if any app's tests fail.

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root" || exit 1

export PATH="${HOME}/.pub-cache/bin:${PATH}"

apps_file="${repo_root}/coverage_pipeline/playground_apps"
if [ ! -f "$apps_file" ]; then
  echo "pre-push: missing ${apps_file}." >&2
  exit 1
fi

fail_push() {
  app=$1
  msg="Tests failed in ${app}. Fix the tests, then push again."
  echo "$msg"
  echo "$msg" >&2
  exit 1
}

echo "Running tests before push…"

while IFS= read -r app || [ -n "${app:-}" ]; do
  case "$app" in
    '' | \#*) continue ;;
  esac
  app_root="${repo_root}/${app}"
  if [ -f "${app_root}/.fvmrc" ] && command -v fvm >/dev/null 2>&1; then
    if ! (cd "$app_root" && fvm flutter test --reporter compact); then
      fail_push "$app"
    fi
  else
    if ! (cd "$app_root" && flutter test --reporter compact); then
      fail_push "$app"
    fi
  fi
done <"$apps_file"

echo "All tests passed."
exit 0
