#!/bin/sh
# Playground monorepo: block the push if any app's tests fail.

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root" || exit 1

export PATH="${HOME}/.pub-cache/bin:${PATH}"

apps_file="${repo_root}/coverage_pipeline/playground_apps"
if [ ! -f "$apps_file" ]; then
  echo "pre-push: missing ${apps_file}." >&2
  exit 1
fi

echo "pre-push: running tests…"

while IFS= read -r app || [ -n "${app:-}" ]; do
  case "$app" in
    '' | \#*) continue ;;
  esac
  app_root="${repo_root}/${app}"
  echo "pre-push: ${app}"
  if [ -f "${app_root}/.fvmrc" ] && command -v fvm >/dev/null 2>&1; then
    if ! (cd "$app_root" && fvm flutter test); then
      echo "pre-push: tests failed in ${app}. Push blocked." >&2
      exit 1
    fi
  else
    if ! (cd "$app_root" && flutter test); then
      echo "pre-push: tests failed in ${app}. Push blocked." >&2
      exit 1
    fi
  fi
done <"$apps_file"

echo "pre-push: all tests passed."
exit 0
