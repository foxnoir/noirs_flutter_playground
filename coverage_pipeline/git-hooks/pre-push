#!/bin/sh
# Block the push if tests fail. Coverage already belongs to the commits
# (pre-commit). Do not create a follow-up coverage commit here.

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root" || exit 1

export PATH="${HOME}/.pub-cache/bin:${PATH}"

runner="${repo_root}/coverage_pipeline/run_flutter_tests.sh"
if [ ! -x "$runner" ]; then
  echo "pre-push: missing ${runner}." >&2
  exit 1
fi

echo "pre-push: running tests…"

if ! "$runner" "$repo_root" "."; then
  exit 1
fi

echo "pre-push: all tests passed."
exit 0
