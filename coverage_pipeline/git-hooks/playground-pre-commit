#!/bin/sh
# Playground monorepo: include current coverage for every app in THIS commit.

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root" || exit 1

export PATH="${HOME}/.pub-cache/bin:${PATH}"

if [ ! -x "${repo_root}/coverage_pipeline/update_all.sh" ]; then
  echo "pre-commit: coverage_pipeline/update_all.sh is missing." >&2
  exit 1
fi

if ! "${repo_root}/coverage_pipeline/update_all.sh"; then
  echo "pre-commit: tests or coverage update failed. Commit blocked." >&2
  exit 1
fi

apps_file="${repo_root}/coverage_pipeline/playground_apps"
while IFS= read -r app || [ -n "${app:-}" ]; do
  case "$app" in
    '' | \#*) continue ;;
  esac
  for file in \
    "${app}/assets/coverage/badge.svg" \
    "${app}/assets/coverage/card.svg" \
    "${app}/README.md"; do
    [ -f "$file" ] || continue
    git add -- "$file"
  done
done <"$apps_file"

echo "pre-commit: coverage badges included in this commit."
exit 0
