    {
      "label": "Build Runner Watch",
      "type": "shell",
      "command": "fvm dart run build_runner watch --force-jit",
      "options": {
        "cwd": "${workspaceFolder}/riverpod_basics",
        "env": {
          "PATH": "${env:HOME}/.pub-cache/bin:${env:PATH}"
        }
      },
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": []
    }
  ]
