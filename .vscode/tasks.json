{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Boot iPhone 17 Pro Simulator",
      "type": "shell",
      "command": "xcrun simctl boot E207ED10-9E72-4D1C-82E5-4B23BB22D09B 2>/dev/null || true; open -a Simulator",
      "presentation": {
        "reveal": "silent",
        "panel": "dedicated",
        "showReuseMessage": false
      },
      "problemMatcher": []
    },
    {
      "label": "Pub Get",
      "type": "shell",
      "command": "fvm flutter pub get",
      "options": {
        "cwd": "${workspaceFolder}/riverpod_basics",
        "env": {
          "PATH": "${env:HOME}/.pub-cache/bin:${env:PATH}"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "Flutter Doctor",
      "type": "shell",
      "command": "fvm flutter doctor",
      "options": {
        "cwd": "${workspaceFolder}/riverpod_basics",
        "env": {
          "PATH": "${env:HOME}/.pub-cache/bin:${env:PATH}"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "Flutter Test",
      "type": "shell",
      "command": "fvm flutter test",
      "options": {
        "cwd": "${workspaceFolder}/riverpod_basics",
        "env": {
          "PATH": "${env:HOME}/.pub-cache/bin:${env:PATH}"
        }
      },
      "group": "test",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "Flutter: Test with coverage",
      "type": "shell",
      "command": "fvm flutter test --coverage",
      "options": {
        "cwd": "${workspaceFolder}/riverpod_basics",
        "env": {
          "PATH": "${env:HOME}/.pub-cache/bin:${env:PATH}"
        }
      },
      "group": "test",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "Flutter: Test starter with coverage",
      "type": "shell",
      "command": "fvm flutter test --coverage",
      "options": {
        "cwd": "${workspaceFolder}/app_starters/riverpod_basic_starter",
        "env": {
          "PATH": "${env:HOME}/.pub-cache/bin:${env:PATH}"
        }
      },
      "group": "test",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "Flutter Run Riverpod Basics",
      "type": "shell",
      "command": "fvm flutter run",
      "options": {
        "cwd": "${workspaceFolder}/riverpod_basics",
        "env": {
          "PATH": "${env:HOME}/.pub-cache/bin:${env:PATH}"
        }
      },
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": []
    },
    {
      "label": "Flutter Run Advanced Concepts",
      "type": "shell",
      "command": "fvm flutter run",
      "options": {
        "cwd": "${workspaceFolder}/advanced_concepts",
        "env": {
          "PATH": "${env:HOME}/.pub-cache/bin:${env:PATH}"
        }
      },
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": []
    },
    {
      "label": "Build Runner",
      "type": "shell",
      "command": "fvm dart run build_runner build --force-jit",
      "options": {
        "cwd": "${workspaceFolder}/riverpod_basics",
        "env": {
          "PATH": "${env:HOME}/.pub-cache/bin:${env:PATH}"
        }
      },
      "presentation": {
