{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Flutter",
      "request": "launch",
      "type": "dart",
      "emulatorId": "apple_ios_simulator",
      "preLaunchTask": "Boot iPhone 17 Pro Simulator"
    },
    {
      "name": "Riverpod Basics",
      "request": "launch",
      "type": "dart",
      "cwd": "${workspaceFolder}/riverpod_basics",
      "program": "lib/main.dart",
      "templateFor": "riverpod_basics",
      "codeLens": {
        "for": ["run-file", "debug-file"],
        "path": "riverpod_basics",
        "title": "${debugType} Riverpod Basics"
      },
      "emulatorId": "apple_ios_simulator",
      "preLaunchTask": "Boot iPhone 17 Pro Simulator"
    },
    {
      "name": "Advanced Concepts",
      "request": "launch",
      "type": "dart",
      "cwd": "${workspaceFolder}/advanced_concepts",
      "program": "lib/main.dart",
      "templateFor": "advanced_concepts",
      "codeLens": {
        "for": ["run-file", "debug-file"],
        "path": "advanced_concepts",
        "title": "${debugType} Advanced Concepts"
      },
      "emulatorId": "apple_ios_simulator",
      "preLaunchTask": "Boot iPhone 17 Pro Simulator"
    },
    {
      "name": "Advanced Concepts (Chrome)",
      "request": "launch",
      "type": "dart",
      "cwd": "${workspaceFolder}/advanced_concepts",
      "program": "lib/main.dart",
      "deviceId": "chrome"
    },
    {
      "name": "Firebase in Depth (Chrome)",
      "request": "launch",
      "type": "dart",
      "cwd": "${workspaceFolder}/firebase_in_depth",
      "program": "lib/main.dart",
      "deviceId": "chrome",
      "templateFor": "firebase_in_depth",
      "codeLens": {
        "for": ["run-file", "debug-file"],
        "path": "firebase_in_depth",
        "title": "${debugType} Firebase in Depth (Chrome)"
      }
    },
    {
      "name": "Firebase in Depth (emulator)",
      "request": "launch",
      "type": "dart",
      "cwd": "${workspaceFolder}/firebase_in_depth",
      "program": "lib/main.dart",
      "deviceId": "chrome",
      "toolArgs": ["--dart-define=USE_FIREBASE_EMULATOR=true"]
    },
    {
      "name": "Firebase in Depth (iOS)",
      "request": "launch",
      "type": "dart",
      "cwd": "${workspaceFolder}/firebase_in_depth",
      "program": "lib/main.dart",
      "emulatorId": "apple_ios_simulator",
      "preLaunchTask": "Boot iPhone 17 Pro Simulator"
    }
  ]
}
