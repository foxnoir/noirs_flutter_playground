rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /courses/{courseId} {
      allow read: if true;
      allow write: if false;

      match /lessons/{lessonId} {
        allow read: if true;
        allow write: if false;
      }
    }

    match /{path=**}/lessons/{lessonId} {
      allow read: if true;
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
