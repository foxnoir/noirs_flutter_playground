{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Flutter: Test with coverage",
      "type": "shell",
      "command": "fvm flutter test --coverage",
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "PATH": "${env:HOME}/.pub-cache/bin:${env:PATH}"
        }
      },
      "group": "test",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    }
  ]
}
