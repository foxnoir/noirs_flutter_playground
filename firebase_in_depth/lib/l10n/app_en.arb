  "fundamentalsQueryTitle": "Performance guarantees and indexes",
  "@fundamentalsQueryTitle": {
    "description": "Section title for the index lab."
  },
  "fundamentalsQueryHint": "Firestore answers from **indexes**, not by scanning the collection. That is the performance guarantee: query cost stays predictable as the data grows. One **range** filter plus `orderBy` on the same field can use the automatic single-field index. Two range filters on different fields cannot. Equality on one field plus a range on another needs a **composite** index. This lab has one composite (`url` + `seqNo`) and leaves `price` + `seqNo` without one.",
  "@fundamentalsQueryHint": {
    "description": "Explains indexes and the four query buttons."
  },
  "fundamentalsQueryValidTitle": "where seqNo <= 5, orderBy seqNo",
  "@fundamentalsQueryValidTitle": {
    "description": "Monospace title for the valid query card."
  },
  "fundamentalsQueryValidHint": "Inequality and orderBy on the same field. Firestore walks one index. This is the query that works.",
  "@fundamentalsQueryValidHint": {
    "description": "Hint under the valid seqNo query."
  },
  "fundamentalsQueryInvalidTitle": "where seqNo <= 5 and lessonsCount <= 10",
  "@fundamentalsQueryInvalidTitle": {
    "description": "Monospace title for the two-inequality query card."
  },
  "fundamentalsQueryInvalidHint": "Two inequalities on different fields. The Angular sample failed with: all inequality filters must be on the same field. Run it and read the FirebaseError here and in DevTools.",
  "@fundamentalsQueryInvalidHint": {
    "description": "Hint under the invalid two-inequality query."
  },
  "fundamentalsQueryCompositeTitle": "where seqNo <= 20 and url == hiragana-from-zero",
  "@fundamentalsQueryCompositeTitle": {
    "description": "Monospace title for the composite-index query card."
  },
  "fundamentalsQueryCompositeHint": "Range on seqNo plus equality on url. That pair has a composite index in firestore.indexes.json (`url` then `seqNo`). Same shape as the missing-index button, except the index exists.",
  "@fundamentalsQueryCompositeHint": {
    "description": "Hint under the composite url plus seqNo query."
  },
  "fundamentalsQueryIndexTitle": "where seqNo <= 20 and price == 15",
  "@fundamentalsQueryIndexTitle": {
    "description": "Monospace title for the missing-index query card."
  },
  "fundamentalsQueryIndexHint": "Same shape as the composite button, different field pair. There is no composite for `price` + `seqNo`. The error includes a Console URL — do not click it if you want this button to keep failing.",
  "@fundamentalsQueryIndexHint": {
    "description": "Hint under the missing price plus seqNo index query."
  },
