  "fundamentalsLessonsTitle": "Nested collection vs collection group",
  "@fundamentalsLessonsTitle": {
    "description": "Section title for nested lessons vs collection group."
  },
  "fundamentalsLessonsHint": "A **nested** query stays under one course. A **collection group** query walks every `lessons` subcollection in the project. That is how you list all lessons without knowing each course id. Rules need a recursive match on `lessons`. `orderBy seqNo` needs a `COLLECTION_GROUP` index.",
  "@fundamentalsLessonsHint": {
    "description": "Explains nested lessons vs collectionGroup."
  },
  "fundamentalsLessonsNestedTitle": "courses/hiragana-from-zero/lessons orderBy seqNo",
  "@fundamentalsLessonsNestedTitle": {
    "description": "Monospace title for the nested lessons card."
  },
