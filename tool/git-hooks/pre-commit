#!/bin/sh
# Include current coverage in THIS commit so GitHub never shows a stale badge.

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root" || exit 1

export PATH="${HOME}/.pub-cache/bin:${PATH}"

if [ ! -x "${repo_root}/tool/update_coverage.sh" ]; then
  echo "pre-commit: tool/update_coverage.sh is missing." >&2
  exit 1
fi

if ! "${repo_root}/tool/update_coverage.sh"; then
  echo "pre-commit: tests or coverage update failed. Commit blocked." >&2
  exit 1
fi

for file in */images/coverage.svg */images/coverage_badge.svg */README.md; do
  [ -f "$file" ] || continue
  case "$file" in
    */README.md)
      grep -q "coverage-percent:start" "$file" || continue
      ;;
  esac
  git add -- "$file"
done

echo "pre-commit: coverage badge included in this commit."
exit 0
