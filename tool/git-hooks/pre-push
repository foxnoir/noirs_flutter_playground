#!/bin/sh
# Block the push if tests fail. Coverage already belongs to the commits
# (pre-commit). Do not create a follow-up coverage commit here.

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root" || exit 1

export PATH="${HOME}/.pub-cache/bin:${PATH}"

found_project=0
failed=0

for pubspec in */pubspec.yaml; do
  [ -f "$pubspec" ] || continue
  found_project=1
  project_dir="$(dirname "$pubspec")"
  echo "pre-push: running tests in ${project_dir}…"

  if [ -f "${project_dir}/.fvmrc" ] && command -v fvm >/dev/null 2>&1; then
    if ! (cd "$project_dir" && fvm flutter test); then
      echo "pre-push: tests failed in ${project_dir}. Push blocked." >&2
      failed=1
    fi
  else
    if ! (cd "$project_dir" && flutter test); then
      echo "pre-push: tests failed in ${project_dir}. Push blocked." >&2
      failed=1
    fi
  fi
done

if [ "$found_project" -eq 0 ]; then
  echo "pre-push: no Flutter projects found. Push blocked." >&2
  exit 1
fi

if [ "$failed" -ne 0 ]; then
  exit 1
fi

echo "pre-push: all tests passed."
exit 0
