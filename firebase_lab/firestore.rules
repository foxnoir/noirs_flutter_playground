rules_version = '2';

// Practice project: open on purpose so the HTTP API and a Flutter
// Firestore SDK client can both write without Auth. Do not copy this
// into a real app.
service cloud.firestore {
  match /databases/{database}/documents {
    match /notes/{noteId} {
      allow read, write: if true;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
